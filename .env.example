# ==========================================================
# Bar Exchange Backend — пример переменных окружения.
# Никогда не коммитьте настоящий .env с реальными значениями.
# ==========================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME=Bar Exchange Backend
APP_TIMEZONE=Asia/Almaty
LOG_LEVEL=info

# PostgreSQL (Railway: reference на переменную Postgres-сервиса)
DATABASE_URL=

# Ключ администратора (сгенерируйте случайную строку минимум 24 символа)
ADMIN_API_KEY=
ADMIN_API_KEY_HEADER=x-admin-api-key

# Разрешённые origins для браузерного frontend, через запятую
CORS_ORIGINS=http://localhost:5173,https://YOUR-CLOUDFLARE-FRONTEND.example

# iiko Cloud API
IIKO_API_BASE_URL=https://api-ru.iiko.services/api/1
IIKO_API_KEY=
IIKO_ORGANIZATION_ID=
IIKO_TERMINAL_GROUP_ID=
IIKO_REQUEST_TIMEOUT_MS=15000
IIKO_SYNC_ENABLED=true
IIKO_DEBUG_RAW_PAYLOADS=false

# iiko webhooks (v0.1: только приём и сохранение событий)
IIKO_WEBHOOK_SECRET=
IIKO_WEBHOOK_URL=

# Telegram-алерты
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_ALERT_COOLDOWN_SECONDS=900

# Будущий iikoFront plugin (v0.1: контракт API, C#-плагина ещё нет)
FRONT_PLUGIN_ENABLED=false
FRONT_PLUGIN_SHARED_SECRET=
FRONT_PLUGIN_ALLOWED_TERMINAL_IDS=

# Ценовой движок
PRICE_PUBLISHER_MODE=disabled
PRICE_ROUND_INTERVAL_MINUTES=15
PRICE_ROUND_PREPARE_MINUTES_BEFORE=3
PRICE_MAX_CHANGE_PERCENT=10
PRICE_DEFAULT_STEP=50
