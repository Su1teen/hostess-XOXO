# ==========================================================
# Bar Exchange Backend — production environment variables
# Не коммитить .env в GitHub
# ==========================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_NAME=Bar Exchange Backend
APP_TIMEZONE=Asia/Almaty
LOG_LEVEL=info


# PostgreSQL
# В Railway лучше выбрать Add Reference → Postgres → DATABASE_URL,
# а не вставлять строку руками.
DATABASE_URL=postgresql://postgres:BcZNtWhUHDwkzmYaNSHxUHzYCMLYPYNh@postgres.railway.internal:5432/railway


# Ключ для входа в /admin и всех /api/v1/admin/* endpoints
# Генерируешь сам, это НЕ ключ от iiko.
ADMIN_API_KEY=admin-api-key-1234567890
ADMIN_API_KEY_HEADER=x-admin-api-key


# Сюда вставить настоящий URL твоего уже задеплоенного Cloudflare frontend.
CORS_ORIGINS=http://localhost:5173,https://YOUR-PROJECT.pages.dev


# ==========================================================
# iiko Cloud API
# ==========================================================

# Auth и полное menu используют РАЗНЫЕ базы iiko Cloud API.
#   auth: POST {IIKO_AUTH_BASE_URL}{IIKO_AUTH_PATH}
#   menu: POST {IIKO_MENU_BASE_URL}{IIKO_MENU_BY_ID_PATH}
IIKO_AUTH_BASE_URL=https://api-ru.iiko.services/api/v2
IIKO_MENU_BASE_URL=https://api-ru.iiko.services/api/2

# То, что тебе прислали как «accesstoken: 7618...»
# В этом проекте используем как API login / API key.
IIKO_API_KEY=replace-with-iiko-api-login
# Подтверждённое имя поля auth body. Не менять на apiKey.
IIKO_AUTH_API_KEY_FIELD=apiLogin

# То, что тебе прислали как «appID: ...»
IIKO_APP_ID=replace-with-iiko-app-id

# То, что тебе прислали как «Client_secret: ...»
IIKO_CLIENT_SECRET=replace-with-iiko-client-secret

# Пути относительно соответствующих base URL.
# Final auth URL = https://api-ru.iiko.services/api/v2/access_token
# Final menu URL = https://api-ru.iiko.services/api/2/menu/by_id
# Полное внешнее меню берётся только через настраиваемый путь /menu/by_id.
IIKO_AUTH_PATH=/access_token
IIKO_MENU_BY_ID_PATH=/menu/by_id

# Флаги тела запроса авторизации (boolean, не строки).
IIKO_AUTH_RETURN_ADDITIONAL_INFO=false
IIKO_AUTH_INCLUDE_DISABLED=false

# Организация и внешнее меню для запроса полного меню /api/2/menu/by_id.
# IIKO_ORGANIZATION_ID — ID организации из iiko.
# IIKO_EXTERNAL_MENU_ID — ID внешнего меню (externalMenuId).
IIKO_ORGANIZATION_ID=cc9baa8d-cfac-4092-9c97-477746fe84e2
IIKO_EXTERNAL_MENU_ID=88042
IIKO_TERMINAL_GROUP_ID=

IIKO_REQUEST_TIMEOUT_MS=15000
IIKO_SYNC_ENABLED=true
IIKO_DEBUG_RAW_PAYLOADS=false


# ==========================================================
# iiko Webhooks
# ==========================================================

# Пока webhook не настраиваем — оставляем пустым.
# Не вставлять сюда iiko Client_secret.
IIKO_WEBHOOK_SECRET=
IIKO_WEBHOOK_URL=


# ==========================================================
# Telegram
# ==========================================================

TELEGRAM_ENABLED=true

# Токен твоего бота из BotFather
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token

# Твой chat ID
TELEGRAM_ALERT_CHAT_ID=replace-with-telegram-chat-id

TELEGRAM_ALERT_COOLDOWN_SECONDS=900


# ==========================================================
# Будущий iikoFront plugin
# ==========================================================

FRONT_PLUGIN_ENABLED=false
FRONT_PLUGIN_SHARED_SECRET=
FRONT_PLUGIN_ALLOWED_TERMINAL_IDS=


# ==========================================================
# Ценовой движок
# ==========================================================

PRICE_PUBLISHER_MODE=disabled
PRICE_ROUND_INTERVAL_MINUTES=15
PRICE_ROUND_PREPARE_MINUTES_BEFORE=3
PRICE_MAX_CHANGE_PERCENT=10
PRICE_DEFAULT_STEP=50