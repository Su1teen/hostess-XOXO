// Bar Exchange Backend — Prisma schema (PostgreSQL).
// Деньги хранятся как Decimal (KZT, 2 знака), floating point для денег не используется.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  UNKNOWN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  STOPPED
  ARCHIVED
}

enum RoundType {
  NORMAL
  CRASH
}

enum SaleSource {
  MANUAL_PANEL
}

enum RoundStatus {
  DRAFT
  SIMULATED
  READY_FOR_REVIEW
  APPROVED
  APPLYING_TO_IIKO
  APPLIED_TO_IIKO
  PUBLISHED
  FAILED
  ROLLED_BACK
  CANCELLED
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
}

enum SalesEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  DUPLICATE
  FAILED
}

enum AuditAction {
  IIKO_AUTH
  IIKO_ORGANIZATIONS_SYNC
  IIKO_MENU_SYNC
  PRODUCT_SELECTED
  PRODUCT_UPDATED
  ROUND_CREATED
  ROUND_SIMULATED
  ROUND_APPROVED
  ROUND_PUBLISHED
  ROUND_ROLLED_BACK
  WEBHOOK_RECEIVED
  PLUGIN_QUOTE_REQUESTED
  TELEGRAM_ALERT_SENT
  ADMIN_ACTION
}

model Organization {
  id                 String             @id @default(uuid()) @db.Uuid
  iikoOrganizationId String             @unique @map("iiko_organization_id")
  name               String
  status             OrganizationStatus @default(UNKNOWN)
  isSelected         Boolean            @default(false) @map("is_selected")
  metadata           Json?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  products         Product[]
  priceRounds      PriceRound[]
  salesEvents      SalesEvent[]
  iikoSyncAttempts IikoSyncAttempt[]

  @@index([isSelected])
  @@map("organizations")
}

model Product {
  id                    String        @id @default(uuid()) @db.Uuid
  organizationId        String        @map("organization_id") @db.Uuid
  // Собственный стабильный ключ биржевой позиции; iiko IDs остаются nullable.
  exchangeKey           String?       @unique @map("exchange_key")
  category              String?
  volumeMl              Int?          @map("volume_ml")
  startPrice            Decimal?      @map("start_price") @db.Decimal(12, 2)
  currentPrice          Decimal?      @map("current_price") @db.Decimal(12, 2)
  // Идентификаторы iiko: item + size дают уникальный вариант товара.
  iikoItemId            String?       @map("iiko_item_id")
  iikoSizeId            String?       @map("iiko_size_id")
  // Сырой product id из iiko (nullable — API может использовать иное поле).
  iikoProductId         String?       @map("iiko_product_id")
  iikoParentGroupId     String?       @map("iiko_parent_group_id")
  name                  String
  displayName           String        @map("display_name")
  description           String?
  sizeName              String?       @map("size_name")
  sizeCode              String?       @map("size_code")
  sku                   String?
  productType           String?       @map("product_type")
  unit                  String?
  categoryId            String?       @map("category_id")
  categoryName          String?       @map("category_name")
  basePrice             Decimal       @default(0) @map("base_price") @db.Decimal(12, 2)
  currentKnownIikoPrice Decimal?      @map("current_known_iiko_price") @db.Decimal(12, 2)
  currentExchangePrice  Decimal?      @map("current_exchange_price") @db.Decimal(12, 2)
  minPrice              Decimal?      @map("min_price") @db.Decimal(12, 2)
  maxPrice              Decimal?      @map("max_price") @db.Decimal(12, 2)
  priceStep             Decimal       @default(50) @map("price_step") @db.Decimal(12, 2)
  maxChangePercent      Decimal       @default(10) @map("max_change_percent") @db.Decimal(6, 2)
  currency              String        @default("KZT")
  isDrinkCandidate      Boolean       @default(false) @map("is_drink_candidate")
  isSellable            Boolean       @default(true) @map("is_sellable")
  isAvailable           Boolean       @default(true) @map("is_available")
  isExchangeProduct     Boolean       @default(false) @map("is_exchange_product")
  isActive              Boolean       @default(true) @map("is_active")
  status                ProductStatus @default(ACTIVE)
  imageUrl              String?       @map("image_url")
  sourceMenuId          String?       @map("source_menu_id")
  sourceExternalMenuId  String?       @map("source_external_menu_id")
  sourceMetadata        Json?         @map("source_metadata")
  syncWarnings          Json?         @map("sync_warnings")
  metadata              Json?
  lastSeenAt            DateTime?     @map("last_seen_at")
  syncedAt              DateTime?     @map("synced_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roundPrices  RoundPrice[]
  salesEvents  SalesEvent[]
  sales        ExchangeSale[]
  crashEvents  CrashEvent[]

  @@unique([organizationId, iikoItemId, iikoSizeId])
  @@index([name])
  @@index([displayName])
  @@index([categoryName])
  @@index([isDrinkCandidate])
  @@index([isSellable])
  @@index([isExchangeProduct])
  @@index([syncedAt])
  @@index([iikoProductId])
  @@map("products")
}

model PriceRound {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  roundKey         String      @unique @map("round_key")
  startsAt         DateTime    @map("starts_at")
  endsAt           DateTime    @map("ends_at")
  timezone         String
  type             RoundType   @default(NORMAL)
  status           RoundStatus @default(DRAFT)
  algorithmVersion String      @map("algorithm_version")
  triggerSource    String      @map("trigger_source")
  note             String?
  createdAt        DateTime    @default(now()) @map("created_at")
  approvedAt       DateTime?   @map("approved_at")
  publishedAt      DateTime?   @map("published_at")
  createdBy        String?     @map("created_by")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prices           RoundPrice[]
  sales            ExchangeSale[]
  crashEvents      CrashEvent[]
  iikoSyncAttempts IikoSyncAttempt[]

  @@index([organizationId, startsAt])
  @@index([status])
  @@map("price_rounds")
}

model RoundPrice {
  id                String      @id @default(uuid()) @db.Uuid
  roundId           String      @map("round_id") @db.Uuid
  productId         String      @map("product_id") @db.Uuid
  price             Decimal     @db.Decimal(12, 2)
  soldQuantity      Decimal     @default(0) @map("sold_quantity") @db.Decimal(12, 3)
  previousPrice     Decimal     @map("previous_price") @db.Decimal(12, 2)
  calculatedPrice   Decimal     @map("calculated_price") @db.Decimal(12, 2)
  publishedPrice    Decimal?    @map("published_price") @db.Decimal(12, 2)
  minPrice          Decimal     @map("min_price") @db.Decimal(12, 2)
  maxPrice          Decimal     @map("max_price") @db.Decimal(12, 2)
  priceStep         Decimal     @map("price_step") @db.Decimal(12, 2)
  salesQuantity     Decimal     @default(0) @map("sales_quantity") @db.Decimal(12, 3)
  demandScore       Decimal     @default(0) @map("demand_score") @db.Decimal(8, 4)
  changePercent     Decimal     @map("change_percent") @db.Decimal(8, 4)
  calculationInput  Json        @map("calculation_input")
  calculationResult Json        @map("calculation_result")
  status            RoundStatus @default(SIMULATED)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  round   PriceRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([roundId, productId])
  @@index([productId])
  @@map("round_prices")
}

model ExchangeSale {
  id          String     @id @default(uuid()) @db.Uuid
  roundId     String     @map("round_id") @db.Uuid
  productId   String     @map("product_id") @db.Uuid
  quantity    Int
  priceAtSale Decimal    @map("price_at_sale") @db.Decimal(12, 2)
  source      SaleSource @default(MANUAL_PANEL)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  round   PriceRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([roundId, productId])
  @@index([roundId, productId])
  @@map("exchange_sales")
}

model CrashEvent {
  id              String   @id @default(uuid()) @db.Uuid
  roundId         String   @map("round_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  discountPercent Decimal  @map("discount_percent") @db.Decimal(6, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  round   PriceRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([roundId, productId])
  @@map("crash_events")
}

model SalesEvent {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  productId       String?          @map("product_id") @db.Uuid
  externalEventId String           @map("external_event_id")
  iikoOrderId     String?          @map("iiko_order_id")
  source          String
  eventType       String           @map("event_type")
  quantity        Decimal          @default(0) @db.Decimal(12, 3)
  unitPrice       Decimal?         @map("unit_price") @db.Decimal(12, 2)
  occurredAt      DateTime?        @map("occurred_at")
  receivedAt      DateTime         @default(now()) @map("received_at")
  status          SalesEventStatus @default(RECEIVED)
  rawPayload      Json?            @map("raw_payload")
  processedAt     DateTime?        @map("processed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([source, externalEventId])
  @@index([organizationId, receivedAt])
  @@map("sales_events")
}

model IikoSyncAttempt {
  id               String     @id @default(uuid()) @db.Uuid
  organizationId   String?    @map("organization_id") @db.Uuid
  roundId          String?    @map("round_id") @db.Uuid
  operation        String
  requestReference String?    @map("request_reference")
  requestMetadata  Json?      @map("request_metadata")
  responseStatus   Int?       @map("response_status")
  responseMetadata Json?      @map("response_metadata")
  status           SyncStatus @default(PENDING)
  errorCode        String?    @map("error_code")
  errorMessage     String?    @map("error_message")
  startedAt        DateTime   @default(now()) @map("started_at")
  finishedAt       DateTime?  @map("finished_at")
  createdAt        DateTime   @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  round        PriceRound?   @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@index([operation, startedAt])
  @@index([status])
  @@map("iiko_sync_attempts")
}

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  action         AuditAction
  actorType      String      @map("actor_type")
  actorId        String?     @map("actor_id")
  organizationId String?     @map("organization_id") @db.Uuid
  entityType     String?     @map("entity_type")
  entityId       String?     @map("entity_id")
  requestId      String?     @map("request_id")
  summary        String
  metadata       Json?
  ipAddress      String?     @map("ip_address")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model AppSetting {
  key       String   @id
  value     Json
  isSecret  Boolean  @default(false) @map("is_secret")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
