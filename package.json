{
  "name": "bar-exchange-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Bar Exchange Backend — динамические цены бара (iiko Cloud API, read-only v0.1)",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md,html,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,html,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "cron:simulate": "tsx src/jobs/simulate-round.job.ts",
    "cron:simulate:prod": "node dist/jobs/simulate-round.job.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "12.0.1",
    "@fastify/rate-limit": "10.1.1",
    "@fastify/swagger": "9.2.0",
    "@fastify/swagger-ui": "5.1.0",
    "@prisma/client": "5.22.0",
    "decimal.js": "10.4.3",
    "fastify": "5.1.0",
    "fastify-plugin": "5.0.1",
    "luxon": "3.5.0",
    "node-cron": "3.0.3",
    "pino": "9.5.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@types/luxon": "3.4.2",
    "@types/node": "22.9.0",
    "@types/node-cron": "^3.0.11",
    "eslint": "9.14.0",
    "eslint-config-prettier": "9.1.0",
    "pino-pretty": "13.0.0",
    "prettier": "3.3.3",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.14.0",
    "vitest": "2.1.4"
  }
}
